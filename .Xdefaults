! urxvt configuration

URxvt.loginShell: true
URxvt.command: /proj/staq6cana0/design_azp_01/devel/c78636/utilities/bin/zsh

URxvt.font:          xft:MesloLGS NF:size=10:hinting=true:autohint=false,xft:Noto Sans Symbols2:size=10:antialias=true
URxvt.boldFont:      xft:MesloLGS NF:bold:size=10:hinting=true:autohint=false,xft:Noto Sans Symbols2:size=10:antialias=true
URxvt.italicFont:    xft:MesloLGS NF:italic:size=10:hinting=true:autohint=false,xft:Noto Sans Symbols2:size=10:antialias=true

URxvt.scrollBar:     true
URxvt.scrollStyle:   rxvt
URxvt.scrollTtyOutput: false
URxvt.scrollWithBuffer: true

! Colors matched from kitty.conf
URxvt.foreground:    #ffffff
URxvt.background:    #000000
URxvt.color0:        #000000
URxvt.color1:        #ff0000
URxvt.color2:        #00cc00
URxvt.color3:        #ffaa00
URxvt.color4:        #4444ff
URxvt.color5:        #ff00ff
URxvt.color6:        #00cccc
URxvt.color7:        #cccccc
URxvt.color8:        #555555
URxvt.color9:        #ff5555
URxvt.color10:       #55ff55
URxvt.color11:       #ffff55
URxvt.color12:       #5555ff
URxvt.color13:       #ff55ff
URxvt.color14:       #55ffff
URxvt.color15:       #ffffff
